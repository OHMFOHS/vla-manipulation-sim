# Optional: only needed for the LLM planner (--planner llm / auto).
# The rule-based planner works without any key.
ANTHROPIC_API_KEY=
# Optional model override for the LLM planner (default: claude-opus-5-5)
VLA_LLM_MODEL=claude-opus-5-5
# Linux headless rendering (CI): osmesa or egl. macOS uses CGL automatically.
# MUJOCO_GL=osmesa
# PYOPENGL_PLATFORM=osmesa
